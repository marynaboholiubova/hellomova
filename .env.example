# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable API key. Safe to expose to the browser — access is
# enforced by Postgres Row Level Security, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the Supabase service-role key here, and never prefix it with
# NEXT_PUBLIC_. It bypasses Row Level Security and must only exist as a
# server-side secret in your deployment platform, if a future phase needs
# it at all.

# Server-only. Powers the AI Lesson Engine (src/lib/ai/openaiProvider.ts)
# and, as of Phase 8, Pronunciation / Mary's audio transcription
# (src/lib/ai/openaiAudioProvider.ts) — same OpenAI account, two separate
# provider modules. Never prefix with NEXT_PUBLIC_ and never send it to
# the browser. Without it, lesson/pronunciation actions return an honest
# "AI service isn't configured" error instead of fabricated content.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset (see openaiProvider.ts).
OPENAI_MODEL=

# SERVER-ONLY, BYPASSES ROW LEVEL SECURITY. From Supabase Project Settings
# -> API -> service_role (the "secret"/service key, NOT the publishable
# key above). Used exclusively by src/lib/supabase/serviceRole.ts, which
# is imported only by the small set of feature Server Actions whose
# trusted tables grant NO insert/update to the authenticated role at all
# (src/features/lessons/actions.ts, src/lib/languageBrain/ingest.ts +
# src/features/languageBrain/actions.ts, src/lib/assessment/submit.ts,
# and — Phase 8 — src/features/pronunciation/actions.ts). See
# 0005_ai_lesson_engine.sql for why: an authenticated browser session
# shares the same publishable-key credential as the app's own Server
# Actions, so a plain auth.uid()-scoped RLS policy cannot distinguish "our
# server generated this" from "the user typed this directly into
# supabase-js". NEVER prefix with NEXT_PUBLIC_, NEVER send to the browser,
# NEVER reuse this key/client from any other feature without the same
# security review that produced this boundary.
SUPABASE_SERVICE_ROLE_KEY=

