# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable API key. Safe to expose to the browser — access is
# enforced by Postgres Row Level Security, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the Supabase service-role key here, and never prefix it with
# NEXT_PUBLIC_. It bypasses Row Level Security and must only exist as a
# server-side secret in your deployment platform, if a future phase needs
# it at all.

# Server-only. Powers the Phase 3 AI lesson engine (src/lib/ai/). Never
# prefix with NEXT_PUBLIC_ and never send it to the browser — only
# src/lib/ai/openaiProvider.ts reads it. Without it, lesson start/continue
# actions return an honest "AI service isn't configured" error instead of
# a fabricated lesson.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset (see openaiProvider.ts).
OPENAI_MODEL=

# SERVER-ONLY, BYPASSES ROW LEVEL SECURITY. From Supabase Project Settings
# -> API -> service_role (the "secret"/service key, NOT the publishable
# key above). Used exclusively by src/lib/supabase/serviceRole.ts, which
# is imported only by src/features/lessons/actions.ts, because
# lesson_sessions/lesson_messages deliberately grant NO insert/update to
# the authenticated role at all (see 0005_ai_lesson_engine.sql for why —
# an authenticated browser session shares the same publishable-key
# credential as the app's own Server Actions, so a plain auth.uid()-scoped
# RLS policy cannot distinguish "our server generated this" from "the
# user typed this directly into supabase-js"). NEVER prefix with
# NEXT_PUBLIC_, NEVER send to the browser, NEVER reuse this key/client
# from any other feature without the same security review that produced
# this boundary.
SUPABASE_SERVICE_ROLE_KEY=

